# AlertIQ — example deployment environment variables.
# Copy to `.env` at the project root and adjust as needed:
#   cp config/.env.example .env
#
# Note: these are deployment/runtime settings (host, port, CORS). The
# tunable ML/RL pipeline parameters (reward values, drift thresholds,
# training hyperparameters, etc.) live in src/config.py — see
# config/README.md for why that split exists.

# --- API server ---
ALERTIQ_API_HOST=0.0.0.0
ALERTIQ_API_PORT=8000

# --- CORS (comma-separated origins, or * for all — dev default) ---
ALERTIQ_CORS_ORIGINS=*

# --- Frontend (used by frontend/.env in the Vite dev server) ---
VITE_API_BASE_URL=http://localhost:8000
